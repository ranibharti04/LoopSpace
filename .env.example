# ============================================================================
# LOOPSPACE ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local and fill with your project credentials
# ============================================================================

# 1. Supabase PostgreSQL & Auth Credentials
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Configurable Campus Email Domain Restriction (Optional)
# Leave empty to allow any valid email address, or restrict to your college e.g. "@campus.edu"
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=

# 3. Google Sheets Backend API Integration (Server-Side Only)
# Create a Service Account in Google Cloud Console, enable Sheets API, and share your spreadsheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=loopspace-sheets-sync@your-gcp-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=1A2B3C4D5E6F7G8H9I0J_your_spreadsheet_id
